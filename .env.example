PORT=3000
HOST=127.0.0.1
# Keep DEMO_MODE=true for the simplest POC.
DEMO_MODE=true

# SQLite persistence. Defaults to .dakini-state.sqlite in the project directory.
DAKINI_DATABASE_FILE=
# If this legacy JSON file exists and the SQLite database is empty, it is imported once and left untouched.
DAKINI_STATE_FILE=

# Set both values to require HTTP Basic authentication for the app and API.
# In production, choose a unique password with at least 12 characters and use HTTPS.
APP_USERNAME=
APP_PASSWORD=

# Google Cloud OAuth 2.0 Web application credentials for Google Sheets sync.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Required when Google OAuth is configured. Generate using:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Optional authenticated search providers (keep API keys private).
# Brave takes precedence when both provider keys are set.
BRAVE_SEARCH_API_KEY=
# Firecrawl key enables authenticated requests and higher provider limits.
FIRECRAWL_API_KEY=
DISCOVERY_TIME=09:00
DISCOVERY_TIME_ZONE=Asia/Kolkata
# Search queries per source-discovery run (1-100; default 8).
SOURCE_DISCOVERY_SEARCHES_PER_RUN=8
# Maximum simultaneous company-site crawls (1-16; default 8). Per-site robots.txt delays still apply.
DISCOVERY_CRAWL_CONCURRENCY=8
# Maximum concurrent authenticated provider search requests (1-8; default 3).
# Keyless Firecrawl requests are serialized and spaced to respect provider throttling.
AUTHENTICATED_SEARCH_CONCURRENCY=3