PORT=3000
# Keep DEMO_MODE=true for the simplest POC.
DEMO_MODE=true

# Google Cloud OAuth 2.0 Web application credentials for Google Sheets sync.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Optional path for persisting crawl/lead data between local server restarts.
DAKINI_STATE_FILE=